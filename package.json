{
  "name": "music_browser",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A local browser for versioned music project exports.",
  "bin": {
    "music_browser": "./bin/music_browser.mjs"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "share:deploy": "pnpm --use-node-version=22.19.0 exec wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.3.0",
    "express": "^5.1.0",
    "svelte": "^5.38.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "svelte-check": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1"
}
